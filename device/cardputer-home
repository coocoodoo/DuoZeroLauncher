#!/bin/sh
# Home screen for the Cardputer Zero: Duo Launcher is the default launcher.
# Started by APPLaunch.service through
#   ~/.config/systemd/user/APPLaunch.service.d/home-screen.conf
#
# - Duo exits with code 10 only when you choose Settings > Launcher > "Back to the system
#   launcher": then the stock M5Stack launcher starts.
# - Any other exit (a crash) starts Duo again. If it fails 3 times in a row within 30 s of
#   starting, the stock launcher starts instead, so the screen never stays blank.
#
# Boot the stock launcher instead:   touch ~/.config/cardputer-home/use-stock
# Undo completely:                   rm ~/.config/systemd/user/APPLaunch.service.d/home-screen.conf
#                                    systemctl --user daemon-reload && systemctl --user restart APPLaunch

DUO="${CARDPUTER_HOME_DUO:-$HOME/apps/duo-launcher/run.sh}"
STOCK="${CARDPUTER_HOME_STOCK:-/usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch}"
LOG="${CARDPUTER_HOME_LOG:-$HOME/.cache/cardputer-home.log}"
mkdir -p "$(dirname "$LOG")"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

if [ -x "$DUO" ] && [ ! -e "$HOME/.config/cardputer-home/use-stock" ]; then
    fails=0
    while :; do
        log "starting Duo Launcher"
        start=$(date +%s)
        "$DUO"
        code=$?
        if [ "$code" -eq 10 ]; then
            log "Duo Launcher: back to the system launcher chosen"
            break
        fi
        if [ $(($(date +%s) - start)) -lt 30 ]; then
            fails=$((fails + 1))
        else
            fails=0
        fi
        log "Duo Launcher exited with code $code (quick failures: $fails)"
        if [ "$fails" -ge 3 ]; then
            log "Duo Launcher keeps failing; starting the stock launcher"
            break
        fi
        sleep 1
    done
fi
log "starting the stock launcher"
cd /usr/share/APPLaunch 2>/dev/null || cd /
exec "$STOCK"
